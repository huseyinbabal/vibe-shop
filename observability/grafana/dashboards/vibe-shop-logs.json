{
  "uid": "vibe-shop-logs",
  "title": "vibe-shop / Logs",
  "tags": ["vibe-shop", "logs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": { "label": "container", "stream": "{job=\"docker\"}", "type": 1 },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "search",
        "label": "Ara (regex)",
        "type": "textbox",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Log oranı - container başına",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (rate({job=\"docker\", container=~\"$container\"} |~ `(?i)$search` [$__auto]))",
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "logs/s" }, "overrides": [] },
      "options": { "legend": { "showLegend": true, "displayMode": "table", "placement": "right" } }
    },
    {
      "type": "piechart",
      "title": "Log payı (seçili aralık)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 2,
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (count_over_time({job=\"docker\", container=~\"$container\"} |~ `(?i)$search` [$__range]))",
          "legendFormat": "{{container}}",
          "instant": true
        }
      ],
      "options": { "legend": { "showLegend": true, "placement": "right" }, "pieType": "donut" }
    },
    {
      "type": "timeseries",
      "title": "Hata/panik oranı",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (count_over_time({job=\"docker\", container=~\"$container\"} |~ `(?i)\\b(error|panic|fatal|exception)\\b` [5m]))",
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 25, "drawStyle": "bars" },
          "color": { "mode": "fixed", "fixedColor": "red" }
        },
        "overrides": []
      }
    },
    {
      "type": "logs",
      "title": "Loglar",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 14 },
      "id": 4,
      "targets": [
        { "refId": "A", "expr": "{job=\"docker\", container=~\"$container\"} |~ `(?i)$search`" }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ]
}
